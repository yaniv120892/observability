{
  "name": "@yaniv120892/observability",
  "version": "0.1.2",
  "description": "Logging (pino to Better Stack), Sentry, heartbeats and Telegram ops alerts for my apps",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "default": "./dist/next/index.js"
    },
    "./next/sentry": {
      "types": "./dist/next/sentry.d.ts",
      "import": "./dist/next/sentry.js",
      "default": "./dist/next/sentry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@sentry/nextjs": "^11.0.0",
    "@sentry/node": "^11.0.0",
    "next": ">=16.0.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/nextjs": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sentry/nextjs": "^11.9.0",
    "@sentry/node": "^11.9.0",
    "@types/node": "^22.20.5",
    "@yaniv120892/dev-config": "github:yaniv120892/dev-config#v0.1.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "next": "^16.4.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "prettier": "@yaniv120892/dev-config/prettier"
}
